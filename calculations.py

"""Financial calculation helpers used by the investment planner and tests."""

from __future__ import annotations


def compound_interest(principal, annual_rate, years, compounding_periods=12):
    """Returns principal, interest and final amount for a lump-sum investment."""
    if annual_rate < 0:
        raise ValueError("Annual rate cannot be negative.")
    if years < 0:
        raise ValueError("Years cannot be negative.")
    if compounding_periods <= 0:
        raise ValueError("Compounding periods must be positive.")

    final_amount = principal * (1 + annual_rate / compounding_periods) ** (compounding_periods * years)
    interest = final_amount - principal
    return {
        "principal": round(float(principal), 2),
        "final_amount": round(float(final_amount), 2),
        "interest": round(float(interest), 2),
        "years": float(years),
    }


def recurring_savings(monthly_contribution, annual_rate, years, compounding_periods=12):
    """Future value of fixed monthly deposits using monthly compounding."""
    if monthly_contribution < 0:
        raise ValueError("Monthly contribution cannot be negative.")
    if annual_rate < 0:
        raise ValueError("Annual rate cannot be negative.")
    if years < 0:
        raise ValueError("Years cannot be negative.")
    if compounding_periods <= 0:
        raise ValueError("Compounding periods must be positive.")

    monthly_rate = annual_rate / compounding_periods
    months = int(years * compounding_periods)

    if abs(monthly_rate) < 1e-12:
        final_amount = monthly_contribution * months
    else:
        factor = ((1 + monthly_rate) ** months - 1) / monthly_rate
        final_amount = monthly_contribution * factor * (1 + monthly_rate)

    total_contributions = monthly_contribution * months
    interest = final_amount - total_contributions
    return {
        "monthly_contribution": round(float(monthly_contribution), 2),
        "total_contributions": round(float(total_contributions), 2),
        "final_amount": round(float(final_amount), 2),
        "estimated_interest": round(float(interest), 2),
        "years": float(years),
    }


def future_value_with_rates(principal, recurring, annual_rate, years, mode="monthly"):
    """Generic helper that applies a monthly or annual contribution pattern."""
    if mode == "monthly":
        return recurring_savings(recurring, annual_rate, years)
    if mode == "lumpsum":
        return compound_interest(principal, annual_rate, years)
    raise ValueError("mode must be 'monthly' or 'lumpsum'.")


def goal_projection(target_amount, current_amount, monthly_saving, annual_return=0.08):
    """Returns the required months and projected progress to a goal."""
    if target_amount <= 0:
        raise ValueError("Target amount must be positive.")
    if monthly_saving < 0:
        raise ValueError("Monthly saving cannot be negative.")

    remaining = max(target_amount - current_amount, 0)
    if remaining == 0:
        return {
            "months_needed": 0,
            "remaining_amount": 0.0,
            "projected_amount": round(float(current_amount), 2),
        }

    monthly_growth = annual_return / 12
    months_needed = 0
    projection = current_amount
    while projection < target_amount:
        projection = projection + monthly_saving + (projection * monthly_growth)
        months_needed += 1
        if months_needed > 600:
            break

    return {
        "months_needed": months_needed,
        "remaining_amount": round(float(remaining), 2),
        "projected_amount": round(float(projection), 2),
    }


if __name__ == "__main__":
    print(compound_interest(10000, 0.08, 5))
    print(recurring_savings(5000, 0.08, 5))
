        transaction_date = datetime.today().strftime("%Y-%m-%d")
    conn = get_connection()
    try:
        cursor = conn.execute(
            "INSERT INTO wallet_transactions (user_id, direction, label, amount, description, transaction_date) VALUES (?, ?, ?, ?, ?, ?)",
            (user_id, direction, label, float(amount), description, transaction_date),
        )
        conn.commit()
        return cursor.lastrowid
    finally:
        conn.close()


